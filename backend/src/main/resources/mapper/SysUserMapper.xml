<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.asuka.backend.mapper.SysUserMapper">

    <!--
        登录查询必须显式查询 password。
        这里是原生 SQL，MP 的逻辑删除不会自动追加，所以手动写 deleted = 0。
    -->
    <select id="selectByUsernameForLogin" resultType="com.asuka.backend.entity.SysUser">
        SELECT id,
               username,
               password,
               nickname,
               email,
               phone,
               avatar,
               status,
               role,
               last_login_time,
               create_time,
               update_time,
               deleted
        FROM sys_user
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <!--
        复杂条件分页：
        1. 关键字同时匹配用户名、昵称、邮箱；
        2. 状态、角色可选过滤；
        3. 返回列不包含 password；
        4. 分页由 MyBatis-Plus PaginationInnerInterceptor 自动追加 LIMIT。
    -->
    <select id="selectUserPage" resultType="com.asuka.backend.entity.SysUser">
        SELECT id,
               username,
               nickname,
               email,
               phone,
               avatar,
               status,
               role,
               last_login_time,
               create_time,
               update_time
        FROM sys_user
        <where>
            deleted = 0
            <if test="query.keyword != null and query.keyword != ''">
                AND (
                    username LIKE CONCAT('%', #{query.keyword}, '%')
                    OR nickname LIKE CONCAT('%', #{query.keyword}, '%')
                    OR email LIKE CONCAT('%', #{query.keyword}, '%')
                )
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
            <if test="query.role != null and query.role != ''">
                AND role = #{query.role}
            </if>
        </where>
        ORDER BY create_time DESC, id DESC
    </select>

    <!-- 单表聚合统计，使用别名 total 与 RoleCountVO.total 对应 -->
    <select id="countByRole" resultType="com.asuka.backend.vo.RoleCountVO">
        SELECT role,
               COUNT(*) AS total
        FROM sys_user
        WHERE deleted = 0
        GROUP BY role
        ORDER BY total DESC
    </select>

</mapper>
