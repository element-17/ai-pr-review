# 本地开发配置示例
# 使用方法：
#   1. 复制本文件为 application-dev.yml；
#   2. 填入本地 MySQL / Redis 连接信息；
#   3. application-dev.yml 已被 .gitignore 忽略，不要提交真实密码。
pr:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: ai-pr-review
    username: root
    password: your_mysql_password
  redis:
    host: localhost
    port: 6379
    password: your_redis_password
    database: 0
  github:
    # 只用于服务端访问 GitHub，不要提交真实 Token
    token: your_github_token
    api-base-url: https://api.github.com
    connect-timeout-ms: 5000
    read-timeout-ms: 30000
    user-agent: ai-pr-review
    preview-cache-seconds: 60
    # GitHub OAuth App；secret 只放本地/环境变量，不要提交
    oauth:
      client-id: ${PR_GITHUB_OAUTH_CLIENT_ID:}
      client-secret: ${PR_GITHUB_OAUTH_CLIENT_SECRET:}
      callback-url: ${PR_GITHUB_OAUTH_CALLBACK_URL:http://localhost:8080/api/auth/github/callback}
      frontend-login-callback-url: ${PR_GITHUB_OAUTH_FRONTEND_LOGIN_CALLBACK_URL:http://localhost:5173/auth/github/callback}
      frontend-bind-result-url: ${PR_GITHUB_OAUTH_FRONTEND_BIND_RESULT_URL:http://localhost:5173/settings}
      scopes: "${PR_GITHUB_OAUTH_SCOPES:read:user user:email}"
  security:
    # Base64 编码的 32 字节 AES-256 密钥；用于 GitHub token / 模型 API key 加密
    encryption-key: ${PR_SECURITY_ENCRYPTION_KEY:}
    previous-encryption-key: ${PR_SECURITY_ENCRYPTION_KEY_PREVIOUS:}
  task:
    worker-count: 2
    queue-capacity: 100
    dispatch-interval-ms: 5000
  ai:
    # deepseek：真实模型；fake：无 Key 的本地联调/自动化测试
    provider: deepseek
    # 仅本地自建模型/联调时设为 true；生产保持 false
    allow-private-base-url: ${PR_AI_ALLOW_PRIVATE_BASE_URL:false}
    batch-size: 4
    # 大 PR 的批内并发数，1-4；1 表示串行
    batch-concurrency: 2
    max-turns: 6
    max-tool-calls: 8
    deepseek:
      # 推荐用环境变量，不要把真实 Key 写进文件
      api-key: ${DEEPSEEK_API_KEY:}
      # OpenAI 兼容服务的根路径；客户端会追加 /chat/completions，不要在这里带该后缀
      base-url: ${PR_AI_DEEPSEEK_BASE_URL:https://api.commandcode.ai/provider/v1}
      model: ${PR_AI_DEEPSEEK_MODEL:deepseek/deepseek-v4.1-flash}
      connect-timeout-ms: 10000
      read-timeout-ms: 180000
      # 输出 token 上限；V4.1 Flash 的 1M 上下文下网关实测可接受 128K
      max-tokens: 131072
      temperature: 0.1
  app:
    frontend-base-url: http://localhost:5173
    guest-task-ttl-days: 7
