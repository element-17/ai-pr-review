# 复制为 deploy/.env 后再启动；不要提交真实密钥
# 必填：MySQL root/app 密码、Redis 密码
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ai-pr-review
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis

# 必填：OpenAI 兼容中转站配置
# BASE_URL 只写到根路径，不要带 /chat/completions 后缀
PR_AI_DEEPSEEK_API_KEY=replace-with-provider-key
PR_AI_DEEPSEEK_BASE_URL=https://api.example.com/v1
PR_AI_DEEPSEEK_MODEL=deepseek-v4.1-flash
# 可选：本地自建模型/联调才设为 true；生产保持 false
PR_AI_ALLOW_PRIVATE_BASE_URL=false

# 可选：公开仓库可不填，未认证时 GitHub API 限流较低
PR_GITHUB_TOKEN=
# 可选：GitHub API 和 OAuth 可分别配置 HTTP CONNECT 代理；留空则直连
PR_GITHUB_PROXY_HOST=
PR_GITHUB_PROXY_PORT=7890
PR_GITHUB_OAUTH_PROXY_HOST=
PR_GITHUB_OAUTH_PROXY_PORT=7890

# 必填：敏感数据加密密钥（Base64 编码的 32 字节 AES-256 key）
# 生成示例：openssl rand -base64 32
PR_SECURITY_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# 轮换时把旧 key 放这里，只用于解密旧数据
PR_SECURITY_ENCRYPTION_KEY_PREVIOUS=

# GitHub OAuth App：GitHub 登录/绑定使用
PR_GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
PR_GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
PR_GITHUB_OAUTH_CALLBACK_URL=https://example.com/ai-pr-review/api/auth/github/callback
PR_GITHUB_OAUTH_FRONTEND_LOGIN_CALLBACK_URL=https://example.com/ai-pr-review/auth/github/callback
PR_GITHUB_OAUTH_FRONTEND_BIND_RESULT_URL=https://example.com/ai-pr-review/settings
# 可选：默认最小 scope
PR_GITHUB_OAUTH_SCOPES=read:user user:email

# 可选：生成游客分享链接使用的外部访问地址，默认 http://localhost
PUBLIC_BASE_URL=https://example.com/ai-pr-review
