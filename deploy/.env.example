# 复制为 deploy/.env 后再启动；不要提交真实密钥
# 必填：MySQL root/app 密码、Redis 密码
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ai-pr-review
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis

# 必填：OpenAI 兼容中转站配置
# BASE_URL 只写到根路径，不要带 /chat/completions 后缀
PR_AI_DEEPSEEK_API_KEY=replace-with-provider-key
PR_AI_DEEPSEEK_BASE_URL=https://your-openai-compatible-endpoint/v1
PR_AI_DEEPSEEK_MODEL=your-model-id

# 可选：公开仓库可不填，未认证时 GitHub API 限流较低
PR_GITHUB_TOKEN=

# 可选：生成游客分享链接使用的外部访问地址，默认 http://localhost
PUBLIC_BASE_URL=http://localhost
